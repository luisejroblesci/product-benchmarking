# Copy to .env and fill in only the keys for the models you enable in bench.config.json.
# Each model entry names its key via "apiKeyEnv"; add more lines here for extra keys/accounts.

# Anthropic (Claude models; also the default judge)
ANTHROPIC_API_KEY=
# OpenAI
OPENAI_API_KEY=
# Google Gemini (Generative Language API)
GOOGLE_GENERATIVE_AI_API_KEY=
# OpenRouter (or any other openai-compatible endpoint; set baseURL in bench.config.json)
OPENROUTER_API_KEY=

# CircleCI personal API token, used by the circleci CLI surface and the hosted MCP server
CIRCLECI_TOKEN=
